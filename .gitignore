# Python 虚拟环境（可重新生成，绝不提交）
.venv/

# Python 字节码缓存（自动生成）
__pycache__/
*.pyc

# pytest 自动生成的缓存（可重新生成，不该提交）
#   .pytest_cache/   —— pytest 记录"上次哪些测试失败过"之类
#   pytest-of-<用户>/ —— 测试用的临时目录（tmp_path 的宿主）
.pytest_cache/
pytest-of-*/

# 测试覆盖率报告（以后加 --cov 时会产生）
.coverage
htmlcov/

# 数据库文件（含本地数据）
*.db
*.sqlite3

# 环境变量与密钥（绝不提交！）
.env

# Node（阶段 4 前后端联调时会用到）
node_modules/
dist/

# 编辑器与操作系统产生的杂物
.vscode/
.DS_Store
Thumbs.db